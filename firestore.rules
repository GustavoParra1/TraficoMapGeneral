    // 🆕 Factores de riesgo (2026-09): observaciones de campo del admin
    // (iluminación, cámaras visibles, visibilidad). Agregar DENTRO del
    // match /clientes/{clienteId} { ... } existente, junto a las demás
    // subcolecciones (barrios, siniestros, cameras, etc.)
    match /factores_riesgo_admin/{docId} {
      allow read: if isStaffDeCliente(clienteId);
      allow create: if isStaffDeCliente(clienteId);
      allow update: if isStaffDeCliente(clienteId);
      allow delete: if isStaffDeCliente(clienteId);
    }
